# Qdrant. The Compose file publishes the HTTP API on this URL.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j Community. Bolt is published by docker-compose.yml. The default password is local only.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-poc
NEO4J_AUTH=neo4j/graphrag-poc
GRAPH_BUILD=corpus

# OpenAI-compatible endpoints. Exported settings override this file.
# EMBEDDING_BACKEND=openai uses OPENAI_BASE_URL. EMBEDDING_BACKEND=fastembed runs a local ONNX model.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GENERATION_MODEL=Qwen/Qwen3-8B
JUDGE_MODEL=Qwen/Qwen3-14B
# Optional generation endpoint/key overrides; empty values use OPENAI_BASE_URL/API_KEY.
GENERATION_BASE_URL=
GENERATION_API_KEY=
# A separate local judge server; change this for your deployment or hosted judge.
JUDGE_BASE_URL=http://127.0.0.1:8001/v1
JUDGE_API_KEY=
GENERATION_MAX_TOKENS=1536
JUDGE_MAX_TOKENS=4096
# Qwen3 automatically requests chat_template_kwargs.enable_thinking=false.
# For servers that do not support that extension, explicitly set the role's value to {}.
# GENERATION_EXTRA_BODY={}
# JUDGE_EXTRA_BODY={}
# Evaluation caches generation by model/settings, question, passages, and graph hints.
# Unset uses data/eval/answers; an explicitly empty value disables generation caching.
# GENERATION_CACHE_DIR=
RERANKER_MODEL=
RERANK_ENABLED=false

# Historical reports (not the revised evaluation defaults) used:
#   EMBEDDING_BACKEND=fastembed
#   EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   GENERATION_MODEL=Qwen3-0.6B
#   JUDGE_MODEL=Qwen3-0.6B
#   OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# These historical scores cannot be reproduced against the revised questions/protocol.
# Use make model-check for configuration-only preflight. No model requests are made.
# make model-smoke-plan validates a small supplied-evidence suite without endpoint calls.
# make model-probe lists served models; no inference is performed.
# make model-smoke runs LIVE inference: at most 3 generator + 3 judge calls, no cache reuse.

# Evaluation generation settings. Temperature 0 and a fixed seed keep reports comparable.
GENERATION_TEMPERATURE=0
GENERATION_SEED=0
