# Qdrant. The Compose file publishes the HTTP API on this URL.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenAI-compatible endpoint. Model ids are chosen when indexing and generation are wired.
# EMBEDDING_BACKEND=openai uses OPENAI_BASE_URL. EMBEDDING_BACKEND=fastembed runs a local ONNX model.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=
GENERATION_MODEL=
RERANKER_MODEL=
RERANK_ENABLED=false

# Evaluation generation settings. Temperature 0 and a fixed seed keep reports comparable.
GENERATION_TEMPERATURE=0
GENERATION_SEED=0
