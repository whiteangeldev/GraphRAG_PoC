# Qdrant. The Compose file publishes the HTTP API on this URL.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j Community. Bolt is published by docker-compose.yml. The default password is local only.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-poc
NEO4J_AUTH=neo4j/graphrag-poc
GRAPH_BUILD=corpus

# OpenAI-compatible endpoint. Model ids are chosen when indexing and generation are wired.
# EMBEDDING_BACKEND=openai uses OPENAI_BASE_URL. EMBEDDING_BACKEND=fastembed runs a local ONNX model.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=
GENERATION_MODEL=
JUDGE_MODEL=
RERANKER_MODEL=
RERANK_ENABLED=false

# The cached baseline report was produced with:
#   EMBEDDING_BACKEND=fastembed
#   EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   GENERATION_MODEL=Qwen3-0.6B
#   JUDGE_MODEL=Qwen3-0.6B
#   OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# `make eval` uses those defaults unless the variables are already set.

# Evaluation generation settings. Temperature 0 and a fixed seed keep reports comparable.
GENERATION_TEMPERATURE=0
GENERATION_SEED=0
